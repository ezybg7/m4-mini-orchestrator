#!/opt/homebrew/bin/python3
"""Assign the right actor for whatever column an issue sits in.

Multica triggers runs on ASSIGNMENT, never on status. Everett's board model is the other
way round: the column says what should happen to an issue. This closes that gap — it polls
the board and, when an issue's column implies an actor different from its current assignee,
it assigns that actor, which is what starts the run.

    Todo       -> claude-planner      PRD + spec (+ the HIG pass), opens the spec PR
    Code       -> codex-implementer   builds from the merged spec, opens the PR
    In Review  -> review (squad)      three lenses in parallel, one findings list

Backlog, Blocked, Done and Cancelled are never touched: they are parking, not stages.

The one rule that keeps this safe: **act only when the desired actor differs from the
current one.** A failed task leaves the assignee in place, so a failing agent is never
re-triggered in a loop — retries are deliberate (a human, or multica-restart-planner.sh).
An issue in In Review assigned to everettyan has been approved and is waiting on his merge;
it is left alone, or the router would drag it back to the reviewers forever.

Outage mode. A capacity failure is one model's problem, and the Astra->Sol fallback answers it.
When the Codex *account* runs out of credits, both its models fail identically and there is
nothing to fall back to — the work has to leave the runtime. While
~/agents/logs/.multica-codex-outage.json exists with an `until` in the future, Code routes to
claude-implementer instead, a card already handed to codex-implementer is re-routed once, and
the model fallback is skipped entirely. The file is written by --codex-outage-until, or by this
script the first time it sees the usage-limit message on a failed run, and dropped by
--codex-back or by `until` passing — but never while the stand-in still has a run in flight on
a Code card, because Multica starts a task on assignment and does not cancel the one already
running, so handing that card back would put two implementers on one branch. The review squad's
spec-conformance seat is a separate, manual swap: outage mode does not touch squads.

Spec-review fallback. The planner hands a finished spec to the spec reviewer with a @mention and
nothing else — no column move, no re-assignment, because the card is still the planner's. A reviewer
run that dies takes the whole handoff with it, and while the Codex account is out of credits it dies
in seconds, every time: the card sits in Todo looking finished, and no other loop here is watching a
card whose column and assignee are already right. So while outage mode is on, a failed
codex-spec-reviewer run carrying the usage-limit message is answered by re-posting the dispatch to
claude-spec-reviewer as a reply under the planner's own mention — once per mention, forever.
"""
import json, os, subprocess, sys

ENV = {**os.environ, "PATH": os.path.expanduser("~/.local/bin") + ":/opt/homebrew/bin:" + os.environ.get("PATH", "")}
# Absolute path, not a name: under launchd the parent PATH is bare, and subprocess resolves
# the executable from the PARENT environment even when env= carries a fuller PATH.
MULTICA = next((c for c in (os.path.expanduser("~/.local/bin/multica"), "/opt/homebrew/bin/multica",
                            "/usr/local/bin/multica") if os.path.exists(c)), "multica")
LOG = os.path.expanduser("~/agents/logs/multica-router.log")
LOCK = os.path.expanduser("~/agents/logs/.multica-router.lock")
RETRIED = os.path.expanduser("~/agents/logs/.multica-router-retried.json")
FALLBACK = os.path.expanduser("~/agents/logs/.multica-model-fallback.json")
OUTAGE = os.path.expanduser("~/agents/logs/.multica-codex-outage.json")

# The Codex agents and the model pair they run on. Everett wants Astra; Astra hits capacity
# ("Selected model is at capacity") and a capacity event is global to the model, not to one
# agent — so when any of them dies that way, all of them fall back, and an hour later they
# all go back to Astra to find out whether it has recovered.
# gpt agents that share the one Codex account, flipped Astra<->Sol together on a capacity failure.
# codex-reviewer was archived 2026-09-12 (no agent reviews its own provider's code; Claude reviews gpt code
# cross-provider). researcher-ambry moved to Claude 2026-09-12 (no gpt research). Only these two remain on gpt:
# the implementer and the spec-reviewer (the latter cross-reviews the Claude planner's specs).
CODEX_AGENTS = {"codex-implementer": "8b234c22-58d2-4e3e-9d89-73760b11347c",
                "codex-spec-reviewer": "f420ccd1-31fe-4c2b-9231-5b2a33de223e"}
PREFERRED, FALLBACK_MODEL, FALLBACK_MINUTES = "gpt-6-astra", "gpt-5.6-sol", 60
DRY = "--dry-run" in sys.argv
CODEX_BACK = "--codex-back" in sys.argv
CODEX_FORCE = "--force" in sys.argv


def flag_value(flag):
    """The value after a flag — `--flag value` or `--flag=value`. None when absent or bare."""
    for n, a in enumerate(sys.argv):
        if a == flag:
            return sys.argv[n + 1] if n + 1 < len(sys.argv) else None
        if a.startswith(flag + "="):
            return a.split("=", 1)[1]
    return None


CODEX_OUTAGE_UNTIL = flag_value("--codex-outage-until")

ROUTES = {"todo": "claude-planner", "code": "codex-implementer", "in_review": "review"}
# What Code routes to while the Codex account is out of credits: the Claude-runtime stand-in.
OUTAGE_ROUTES = {"code": "claude-implementer"}
# The reset Codex names is a week out on this plan; used when the message carries no time.
OUTAGE_DEFAULT_DAYS = 7
# The Claude-runtime stand-in the code column is routed to during an outage, by id: the daemon
# is asked, by agent id, whether one of its runs is still going before a card is handed back.
# (The review squad's spec-conformance stand-in is a manual squad swap and needs no id here.)
STAND_IN_IMPLEMENTER = "8342261f-9b94-428e-8b24-73533914993b"
# What `issue runs --active` counts as work in flight, restated so a CLI that ever answers with
# the full history instead cannot make a finished run read as one that is still going.
IN_FLIGHT = {"queued", "dispatched", "running", "waiting_local_directory"}
# Every actor this script may own. It is both sides of the outage swap, not just the routes in
# force right now, because a card left with the *other* implementer has to still read as a
# routed card — otherwise the "assigned to something else on purpose" guard below skips it and
# it never crosses over (in either direction: into outage mode, or back out of it).
PIPELINE_ACTORS = set(ROUTES.values()) | set(OUTAGE_ROUTES.values())
NEVER_TOUCH = {"backlog", "blocked", "done", "cancelled"}
# In Review assigned here means "approved, waiting on Everett" — not work for the reviewers.
PARKED_WITH = {"in_review": "everettyan"}

# `issue list` answers one page at a time. 100 is the server's own per-request ceiling, so
# this is the fewest round trips a board of any size can be read in.
PAGE_SIZE = 100
# A CLI that reported has_more forever would spin the read until the tick was killed. Twenty
# pages is 2000 issues — far past any real board — and a bounded answer beats a hung router.
MAX_PAGES = 20

# --- the slice loop -------------------------------------------------------------------
# A big card is built one slice per run, because a milestone does not fit in one run's
# context. The cap is a guard against a runaway marker, not a product limit: a card that
# wants more than this many slices wants to be split into sub-issues instead.
SLICE_MAX = 6
# Who may drive a slice loop, by agent id -> name. Derived from the routes rather than
# restated, so the two sides of the outage swap cannot drift apart from the ids here.
SLICE_IMPLEMENTERS = {CODEX_AGENTS[ROUTES["code"]]: ROUTES["code"],
                      STAND_IN_IMPLEMENTER: OUTAGE_ROUTES["code"]}
# 2100-01-01Z, as the stamp for a memory entry that must never come due. See already_retried.
SLICE_FOREVER = 4102444800.0
# The handoff marker the implementer leaves as the `open:` line of its HANDOFF comment.
# Line-anchored, so a marker inside a ``` fence reads straight through — the fence
# delimiters sit on their own lines and never touch this one.
SLICE_MARKER_RE = r"^\s*(?:open:\s*)?next-slice:\s*(\d+)\s*/\s*(\d+)\s*$"
# The same line with anything at all after the colon. Only ever used to tell "the
# implementer wrote a marker and got it wrong" apart from "there is no marker here",
# which are different events: the first is worth a line in the log, the second is not.
SLICE_MARKER_LOOSE_RE = r"^\s*(?:open:\s*)?next-slice:[ \t]*(.*?)[ \t]*$"

# --- the spec-review fallback ----------------------------------------------------------
# The planner's handoff to the spec reviewer is a @mention and nothing else: it writes the PRD and
# the spec on a Todo card, posts one comment mentioning the gpt reviewer, and ends its turn. The
# card does not move and the assignee does not change — the planner still owns it, and will pick it
# up again when the review comes back. The mention IS the dispatch, so a reviewer run that dies
# takes the handoff with it. Everett has un-stalled this by hand twice, both times the same way:
# re-post the dispatch to the Claude-runtime stand-in as a REPLY under the planner's own comment,
# which is exactly what the dead run's trigger_comment_id points at.
PLANNER = "dfc9a82c-870f-49a3-ba16-50a102eaa101"
SPEC_REVIEWER = CODEX_AGENTS["codex-spec-reviewer"]
# The Claude-runtime stand-in for that seat. It also holds the review squad's spec-conformance
# chair, but that is a manual squad swap and none of this loop's business — here it is only ever
# the agent a dead gpt spec review is handed to.
STAND_IN_SPEC_REVIEWER = "8d32d26f-1b25-43fa-bec3-5054b4fa298a"
# The dispatch itself. The stand-in's mention is live, because posting it is what starts the run.
# The planner's is in backticks ON PURPOSE: it tells the reviewer who to wake when it is done, and
# a live mention there would wake the planner now, before there is a review for it to read.
SPEC_FALLBACK_BODY = (
    "Codex spec reviewer is out on the account's usage limit (router outage mode). "
    f"[@claude-spec-reviewer](mention://agent/{STAND_IN_SPEC_REVIEWER}) — please take this review "
    "exactly as dispatched above (both documents, both lenses, `FIND-001…`, a verdict, then "
    "@mention the planner back with "
    f"`[@claude-planner](mention://agent/{PLANNER})`).")


def mc(*args, stdin=None):
    """Run the CLI. `stdin` feeds a --content-stdin body, which is how a comment is posted."""
    r = subprocess.run([MULTICA, *args], env=ENV, capture_output=True, text=True, input=stdin)
    return r.stdout if r.returncode == 0 else None


def log(msg):
    from datetime import datetime
    line = f"{datetime.now():%F %T} {msg}"
    print(line)
    with open(LOG, "a") as f:
        f.write(line + "\n")



def already_retried(key, remember=False, forever=False):
    """Rate-limit retries per issue, on disk, because the timeline is not a reliable memory.

    Reading "did this fail?" from the last few timeline entries looked sufficient and was
    not: re-assigning an issue appends events but does not remove the old task_failed, so
    the same issue qualified for a retry on three consecutive ticks and queued duplicate
    tasks behind the one already running. One retry per issue per hour, written down.

    `forever` writes a stamp far enough in the future that neither the hour's rate limit nor
    the day's prune can ever expire the entry — both are `now - stamp` comparisons, and both
    read a future stamp as "just now". Retries want the hour: "try again later" is the right
    answer to a run that died. Slices do not. `{KEY}:slice:{k}` records that slice k has been
    STARTED, and starting it again an hour later would put a second implementer on the same
    branch — the one failure the slice loop exists to prevent. Same file, same format, one
    stamp that never comes due.
    """
    import time
    try:
        state = json.load(open(RETRIED))
    except Exception:
        state = {}
    now = time.time()
    state = {k: v for k, v in state.items() if now - v < 86400}
    recent = (now - state.get(key, 0)) < 3600
    if remember and not recent:
        state[key] = SLICE_FOREVER if forever else now
        try:
            with open(RETRIED, "w") as f:
                json.dump(state, f)
        except Exception as e:
            log(f"could not record the retry of {key}: {e}")
        return False
    return recent


def cancelled_by_server(key):
    """True when the issue's last run died to an infrastructure cancellation, not a decision.

    A daemon restart (bootout/bootstrap, a crash, a kickstart) cancels running tasks and
    stamps "task cancelled by server" on the issue. The task is gone, the assignee is
    unchanged, and nothing will ever pick the work up again — the one failure worth
    retrying automatically. Any other failure is left alone.
    """
    timeline = mc("issue", "timeline", key) or ""
    tail = [l for l in timeline.strip().split("\n") if l.strip()][-4:]
    if not any("task_failed" in l for l in tail):
        return False
    return any("cancelled by server" in l for l in tail)



def set_codex_models(model, why):
    for name, aid in CODEX_AGENTS.items():
        if mc("agent", "update", aid, "--model", model) is None:
            log(f"model switch FAILED for {name} -> {model}")
    log(f"codex agents -> {model} ({why})")


_FAILED_COMMENTS = {}


def failed_comments(key):
    """The newest comment texts on an issue whose last run failed; () when it did not fail.

    Two detectors now ask the same question of the same issues on the same tick — is this
    failure the model's capacity, or the account's credits? — and each answer costs two CLI
    calls. Read it once per run and let both read the cache.
    """
    if key in _FAILED_COMMENTS:
        return _FAILED_COMMENTS[key]
    texts = ()
    timeline = mc("issue", "timeline", key) or ""
    tail = [l for l in timeline.strip().split("\n") if l.strip()][-4:]
    if any("task_failed" in l for l in tail):
        out = mc("issue", "comment", "list", key, "--output", "json", "--compact") or "[]"
        try:
            cs = json.loads(out); cs = cs if isinstance(cs, list) else cs.get("comments", [])
            texts = tuple(c.get("content") or "" for c in cs)[-3:]
        except json.JSONDecodeError:
            texts = ()
    _FAILED_COMMENTS[key] = texts
    return texts


def capacity_failure(key):
    """True when the issue's newest comment is Codex's capacity error after a task_failed."""
    return any("at capacity" in t or "model_not_found_or_unavailable" in t
               for t in failed_comments(key))


def usage_limit_failure(key):
    """True when the newest comment after a task_failed is the account's usage-limit error.

    "You've hit your usage limit … try again at Sep 19th, 2026 4:09 AM" — the limit is on the
    ChatGPT account, so every Codex model under it fails the same way. Deliberately NOT one of
    capacity_failure's phrases: flipping Astra->Sol here would change models and change
    nothing, and would then hide the real cause behind an hour of pointless probing.
    """
    return any("hit your usage limit" in t for t in failed_comments(key))


def model_fallback_tick(issues):
    """Fall back on a capacity failure; restore the preferred model after FALLBACK_MINUTES."""
    import time
    try:
        state = json.load(open(FALLBACK))
    except Exception:
        state = {}
    now = time.time()
    if state.get("since"):
        if now - state["since"] > FALLBACK_MINUTES * 60:
            set_codex_models(PREFERRED, f"{FALLBACK_MINUTES} min elapsed — probing whether Astra has capacity again")
            state = {}
            json.dump(state, open(FALLBACK, "w"))
        return state
    for i in issues:
        if i.get("status") in NEVER_TOUCH:
            continue
        key = i.get("identifier")
        if capacity_failure(key):
            set_codex_models(FALLBACK_MODEL, f"capacity failure on {key}")
            state = {"since": now, "trigger": key}
            json.dump(state, open(FALLBACK, "w"))
            # a pipeline issue whose own run died needs a retry; a squad member's death is the lead's to re-dispatch
            if i.get("status") in ROUTES and i.get("assignee_type") == "agent" and not already_retried(key):
                already_retried(key, remember=True)
                mc("issue", "assign", key, "--unassign"); mc("issue", "assign", key, "--to", ROUTES[i["status"]])
                log(f"retried {key} after the model fallback")
            break
    return state


def read_outage():
    """The outage state, or None when there is no file or it does not hold a state.

    Anything that is not a non-empty JSON object is "no state", not "an odd state": the
    caller checks whether the file is nonetheless there and clears it, because a file that
    is present and ignored is worse than no file — it reads as outage mode to whoever looks.
    """
    try:
        state = json.load(open(OUTAGE))
    except Exception:
        return None
    return state if isinstance(state, dict) and state else None


def outage_deadline(state):
    """The state's `until` as an aware datetime, or None when it cannot be read."""
    from datetime import datetime
    try:
        until = datetime.fromisoformat(state["until"])
    except (KeyError, TypeError, ValueError):
        return None
    return until if until.tzinfo else until.astimezone()


def parse_retry_at(text):
    """The reset time Codex names in the usage-limit message, as an aware local datetime.

    "…try again at Sep 19th, 2026 4:09 AM" carries no zone, and the daemon relays it in the
    box's own time, so it is read as local and stamped with the offset in force on that date.
    """
    import re
    from datetime import datetime
    m = re.search(r"try again at\s+([A-Za-z]{3})[a-z]*\.?\s+(\d{1,2})(?:st|nd|rd|th)?,?\s+"
                  r"(\d{4})[, ]+(\d{1,2}):(\d{2})\s*([AaPp])\.?[Mm]", text)
    if not m:
        return None
    months = {name: n for n, name in enumerate(
        ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"], 1)}
    month = months.get(m.group(1).title())
    if not month:
        return None
    hour = int(m.group(4)) % 12 + (12 if m.group(6).upper() == "P" else 0)
    try:
        return datetime(int(m.group(3)), month, int(m.group(2)), hour, int(m.group(5))).astimezone()
    except ValueError:
        return None


def write_outage(until, reason, set_by):
    """Open outage mode. Returns the state so the caller's own tick already routes by it."""
    state = {"until": until.isoformat(), "reason": reason, "set_by": set_by}
    if DRY:
        log(f"WOULD open codex outage mode until {state['until']} ({reason})")
        return state
    try:
        with open(OUTAGE, "w") as f:
            json.dump(state, f, indent=2)
    except OSError as e:
        log(f"could not write the codex outage state file: {e}")
        return None
    log(f"codex outage mode ON until {state['until']} — code -> {OUTAGE_ROUTES['code']} "
        f"({reason}; set by {set_by})")
    return state


def clear_outage(why):
    """Drop the state file: from this tick on, Code routes to codex-implementer again."""
    if DRY:
        log(f"WOULD clear codex outage mode ({why})")
        return
    try:
        os.remove(OUTAGE)
    except OSError as e:
        log(f"could not delete the codex outage state file: {e}")
        return
    log(f"codex outage over — routing code back to {ROUTES['code']} ({why}); the review squad stays "
        f"all-Claude (codex-reviewer is retired; the spec-conformance seat is claude-spec-reviewer for good)")


def open_outage_by_hand(raw):
    """--codex-outage-until <ISO>: open outage mode until a timestamp a human passed.

    A bad timestamp is a typo, not a routing decision — say so and change nothing, rather
    than opening an outage that ends at an hour nobody meant.
    """
    from datetime import datetime
    if not raw:
        log("--codex-outage-until needs an ISO-8601 timestamp, e.g. 2026-09-19T04:15:00-04:00")
        return None
    try:
        until = datetime.fromisoformat(raw)
    except ValueError:
        log(f"--codex-outage-until: {raw!r} is not an ISO-8601 timestamp")
        return None
    if until.tzinfo is None:
        until = until.astimezone()
    if until <= datetime.now().astimezone():
        log(f"--codex-outage-until: {until.isoformat()} is not in the future — nothing opened")
        return None
    return write_outage(until, "codex account usage limit", "--codex-outage-until")


def run_in_flight(key, agent_id=None):
    """True when that agent has a run on this issue that has not finished.

    `agent_id=None` asks the wider question — is ANYONE working on this card — which is what a loop
    about to dispatch a second actor needs to know, as against a hand-back that cares only about
    the one agent holding the card.

    Unreadable counts as in flight. The two answers are not symmetric: holding a hand-back for
    one more tick costs a minute, and handing a card back under a live run costs a branch.
    """
    out = mc("issue", "runs", key, "--active", "--output", "json")
    if out is None:
        log(f"could not read the runs of {key} — treating it as work in flight")
        return True
    try:
        runs = json.loads(out)
        runs = runs if isinstance(runs, list) else runs.get("runs", [])
    except json.JSONDecodeError:
        log(f"the runs of {key} came back unparseable — treating it as work in flight")
        return True
    return any((agent_id is None or r.get("agent_id") == agent_id)
               and r.get("status") in IN_FLIGHT for r in runs)


def hand_back_held(issues):
    """True when a Code card is mid-run with the stand-in, so the hand-back has to wait.

    Multica starts a task on assignment and does not cancel the one already running, so handing
    a card back to codex-implementer while the stand-in is still building it puts two
    implementers on one branch — the AMBR-30 shape, with a push each. The outage stays open
    until the run ends; the other direction needs no guard, because a Codex run dies in seconds
    while the account is out of credits.
    """
    held = False
    for i in issues:
        if i.get("status") != "code" or i.get("assignee_id") != STAND_IN_IMPLEMENTER:
            continue
        key = i.get("identifier")
        if run_in_flight(key, STAND_IN_IMPLEMENTER):
            log(f"codex outage over but {key} has a claude-implementer run in flight — "
                f"holding the hand-back")
            held = True
    return held


def codex_outage_tick(issues):
    """Hold, close or open outage mode for this tick; returns the active state, or None.

    Opening it is automatic on purpose: the limit lands as a comment on whichever card was
    running, at whatever hour the credits ran out, and a pipeline that waits for a human to
    notice loses the night. The only thing it needs from the message is when to stop.
    """
    from datetime import datetime, timedelta
    state = read_outage()
    if state is None and os.path.exists(OUTAGE):
        log(f"codex outage state file does not hold a usable state ({OUTAGE})")
        clear_outage("unusable state file")
        return None
    if state:
        until = outage_deadline(state)
        if until is None:
            log(f"codex outage state file has an unreadable until ({state.get('until')!r})")
        elif until > datetime.now().astimezone():
            return state
        if hand_back_held(issues):
            return state
        clear_outage("the reset time has passed" if until else "unreadable until")
        return None
    for i in issues:
        if i.get("status") in NEVER_TOUCH:
            continue
        key = i.get("identifier")
        if not usage_limit_failure(key):
            continue
        message = next((t for t in failed_comments(key) if "hit your usage limit" in t), "")
        until = parse_retry_at(message)
        how = "reset time read from the message" if until else \
              f"no reset time in the message — default {OUTAGE_DEFAULT_DAYS} days"
        until = until or (datetime.now().astimezone() + timedelta(days=OUTAGE_DEFAULT_DAYS))
        return write_outage(until, f"codex usage limit hit on {key} ({how})",
                            "multica-router.py (auto-detected)")
    return None


def parse_slice_marker(text):
    """Read an implementer's `next-slice: k/n` handoff marker out of a comment body.

    Three answers, because "there is no marker" and "the marker is wrong" are different
    events and only one of them is worth saying out loud:

        None             no next-slice line at all — ordinary chatter, say nothing
        (k, n, None)     a usable marker
        (None, None, r)  a next-slice line that cannot be honoured, and why

    The strict pattern is tried first, so a comment carrying both a broken marker and a good
    one still builds: a malformed line is a reason to stay quiet about a card, never a
    reason to strand it.
    """
    import re
    if not text:
        return None
    m = re.search(SLICE_MARKER_RE, text, re.IGNORECASE | re.MULTILINE)
    if m:
        k, n = int(m.group(1)), int(m.group(2))
        if k < 2:
            # Slice 1 is the run that is posting this marker. Rerunning for it would rebuild
            # the slice being handed off, on top of itself.
            return None, None, f"k must be at least 2, got {k}/{n} (slice 1 is the run that posted it)"
        if k > n:
            return None, None, f"k is past n ({k}/{n})"
        if n > SLICE_MAX:
            return None, None, f"n is {n}, more than the {SLICE_MAX} slices a card may claim"
        return k, n, None
    loose = re.search(SLICE_MARKER_LOOSE_RE, text, re.IGNORECASE | re.MULTILINE)
    if loose:
        return None, None, f"malformed marker {loose.group(1)!r}"
    return None


def created_time(row):
    """A comment's or a run's created_at as an aware datetime, or None when it cannot be read.

    Comments and run records carry the same field in the same shape, and both are ordered by it
    here: which root comment is the newest, and whether the stand-in reviewer's run started after
    the gpt run it would be standing in for.
    """
    from datetime import datetime
    raw = row.get("created_at")
    if not isinstance(raw, str):
        return None
    try:
        # 3.9's fromisoformat reads the CLI's own `2026-09-12T23:20:25-04:00` but not a `Z`.
        t = datetime.fromisoformat(raw[:-1] + "+00:00" if raw.endswith("Z") else raw)
    except ValueError:
        return None
    return t if t.tzinfo else t.astimezone()


def newest_root_comment(key):
    """The newest top-level comment on an issue, or None when there is none or it is unreadable.

    Roots only, and asked for as `--roots-only`, because a slice marker is a handoff the
    implementer makes to this router — the same words quoted in a reply under someone else's
    thread are discussion ABOUT a handoff, not one. `--roots-only` is also the read the CLI
    never folds, so a resolved thread cannot hide the newest root behind a summary.
    """
    out = mc("issue", "comment", "list", key, "--roots-only", "--output", "json")
    if out is None:
        log(f"could not read the comments of {key} — no slice decision this tick")
        return None
    try:
        cs = json.loads(out)
        cs = cs if isinstance(cs, list) else cs.get("comments", [])
    except json.JSONDecodeError:
        log(f"the comments of {key} came back unparseable — no slice decision this tick")
        return None
    # parent_id is checked again rather than left to the flag: this is what decides whether a
    # fresh run starts, and it costs one comparison not to depend on the CLI honouring it.
    roots = [c for c in cs if isinstance(c, dict) and c.get("parent_id") is None]
    if not roots:
        return None
    stamped = [(created_time(c), n, c) for n, c in enumerate(roots)]
    if all(t is not None for t, _, _ in stamped):
        return max(stamped, key=lambda s: (s[0], s[1]))[2]
    # One unreadable timestamp and the sort means nothing; the CLI answers oldest-first.
    return roots[-1]


def slice_tick(issues, outage=None):
    """Start the next slice of every Code card whose implementer has handed one off.

    A big card is built in slices, one fresh run each, because one run's context does not
    hold a milestone. The implementer ends a slice by pushing it and posting a HANDOFF
    comment whose open line is `next-slice: k/n`, and deliberately does NOT move the card or
    re-assign it: status and assignee are how the board tells a human what is happening, and
    a card still being built has changed neither. That leaves nothing to start slice k —
    Multica triggers on assignment, the assignee is already right, and re-assigning the same
    agent is a no-op. `issue rerun` is the trigger that fits: same assignment, fresh context,
    same per-issue workdir, so slice k opens on the tree slice k-1 pushed.

    Four gates, cheapest first, and every one of them is a reason NOT to start a run: the
    card is a Code card with an implementer on it; that implementer has nothing in flight;
    the newest root comment is its own and carries a marker; and this exact slice has never
    been started before. The last is the one that matters — `rerun` is not idempotent, and
    two runs on one workdir is the failure this whole loop exists to avoid.

    It assigns nothing. Routing is the loop in main()'s business, and a card mid-slice is
    already sitting in the column and with the agent that loop would choose anyway.
    """
    for i in issues:
        if i.get("status") != "code" or i.get("assignee_type") != "agent":
            continue
        agent_id = i.get("assignee_id")
        agent_name = SLICE_IMPLEMENTERS.get(agent_id)
        if not agent_name:
            continue
        # During an outage the Codex account has no credits, so a rerun there dies in seconds
        # and spends the slice's one chance to fire on nothing. That card is the routing
        # loop's to hand across to the stand-in first; it can slice on a later tick.
        if outage and agent_id != STAND_IN_IMPLEMENTER:
            continue
        key = i.get("identifier")
        # Fails closed — an unreadable answer counts as in flight, and run_in_flight says so.
        # A slice started under a live run is two implementers pushing to one branch.
        if run_in_flight(key, agent_id):
            continue
        newest = newest_root_comment(key)
        if newest is None:
            continue
        # The marker has to be the implementer's own word. A human's (or another agent's)
        # `next-slice: 3/4` in the newest root is a request, not a handoff, and the run it
        # would start has no pushed slice underneath it to build on.
        if newest.get("author_type") != "agent" or newest.get("author_id") != agent_id:
            continue
        parsed = parse_slice_marker(newest.get("content") or "")
        if parsed is None:
            continue                    # ordinary comment; the card is simply not mid-slice
        k, n, reason = parsed
        if reason:
            # Keyed on the offending comment, not the card: the same bad marker must not
            # re-log every 60 s, but a NEW bad marker later is a new thing worth seeing.
            # It gates the LOG only — a corrected marker in a later comment still fires.
            bad = f"{key}:slice-bad:{newest.get('id') or reason}"
            if not already_retried(bad):
                log(f"slice marker on {key} ignored: {reason}")
                if not DRY:
                    already_retried(bad, remember=True, forever=True)
            continue
        fired = f"{key}:slice:{k}"
        if DRY:
            if not already_retried(fired):
                log(f"WOULD rerun {key} for slice {k}/{n}")
            continue
        # Remembered BEFORE the rerun, and forever. The two ways to be wrong are not equal: a
        # rerun that is lost costs a stalled card a human can nudge, and a rerun that fires
        # twice costs two agents pushing to one branch. The FAILED line makes the first
        # visible. Its own key, so a slice never spends the card's ordinary retry budget.
        if already_retried(fired, remember=True, forever=True):
            continue
        if mc("issue", "rerun", key) is None:
            log(f"FAILED  slice {k}/{n} of {key} — rerun for {agent_name} did not take")
        else:
            log(f"slice {k}/{n} of {key} — fresh run for {agent_name}")


def spec_review_fallback_tick(issues, outage):
    """Re-dispatch a spec review the gpt reviewer died on, to the Claude stand-in.

    The gap this closes is a handoff that leaves no trace on the board. `claude-planner` writes the
    PRD and the spec on a `todo` card, posts one comment @mentioning `codex-spec-reviewer`, and ends
    its turn — deliberately without moving the card or re-assigning it, because the card is still
    the planner's and the review comes back to it. The mention is the entire dispatch. While the
    Codex account is out of credits that dispatch fails within seconds, and the mention is spent:
    nothing re-posts it, no other loop in this file is watching a card whose column and assignee are
    ALREADY what routing wants, and the card stalls in Todo looking finished until a human reads the
    timeline. Everett has un-stalled it by hand twice, identically, which is the whole design here.

    The dead run says everything needed. Its `trigger_comment_id` is the planner's mention comment,
    so the stand-in is dispatched the way the planner dispatched the original: as a reply under that
    same comment, where the review brief it is being asked to honour is the text directly above it.

    Six gates, cheapest first, and every one of them is a reason NOT to post: outage mode is on;
    the card is a Todo card the planner owns; the gpt reviewer has a failed run on it carrying the
    usage-limit message and a trigger comment; that mention has never been answered before; the
    stand-in has not already run since the death; and nothing is in flight on the card. The memory
    is keyed on the trigger comment and kept forever, like a slice — `comment add` is not
    idempotent, and two reviewers writing findings on one spec is what this must never cause.

    It assigns nothing and moves nothing. The card is already in the column and with the agent the
    routing loop would choose; the only thing missing was the comment.
    """
    if not outage:
        return
    for i in issues:
        if (i.get("status") != "todo" or i.get("assignee_type") != "agent"
                or i.get("assignee_id") != PLANNER):
            continue
        key = i.get("identifier")
        # The full execution history, not --active: the run being looked for is one that already
        # died. `issue runs` answers newest-first, so the first match is the latest attempt. An
        # unreadable answer is no decision — the opposite direction from run_in_flight's, because
        # there the safe answer is "someone is working" and here it is "do nothing at all".
        out = mc("issue", "runs", key, "--output", "json")
        if out is None:
            log(f"could not read the runs of {key} — no spec-review decision this tick")
            continue
        try:
            runs = json.loads(out)
            runs = runs if isinstance(runs, list) else runs.get("runs", [])
        except json.JSONDecodeError:
            log(f"the runs of {key} came back unparseable — no spec-review decision this tick")
            continue
        runs = [r for r in runs if isinstance(r, dict)]
        # The same phrase the outage detector keys on, read here off the run record's `error`
        # rather than off a comment. A run with no trigger_comment_id is no use to this: the
        # mention comment is the thing to reply under, and without it there is nothing to
        # address the stand-in from, so it is not a candidate rather than a card to complain about.
        dead = next((r for r in runs
                     if r.get("agent_id") == SPEC_REVIEWER and r.get("status") == "failed"
                     and "hit your usage limit" in (r.get("error") or "").lower()
                     and r.get("trigger_comment_id")), None)
        if dead is None:
            continue
        trigger = dead["trigger_comment_id"]
        fired = f"{key}:specfallback:{trigger}"
        if already_retried(fired):
            continue
        # A stand-in run that started after the death is this fallback already done — by Everett's
        # hand, or by a tick of this loop whose memory was lost. Ordering the two needs both stamps;
        # when either is unreadable the mere existence of a stand-in run on the card is taken as the
        # answer, because a second dispatch costs a duplicate review and skipping costs only what
        # Everett already un-stalls by hand.
        died = created_time(dead)
        answered = False
        for r in runs:
            if r.get("agent_id") != STAND_IN_SPEC_REVIEWER:
                continue
            ran = created_time(r)
            if died is None or ran is None or ran > died:
                answered = True
        if answered:
            continue
        # Any agent, not just one: the question is whether the card is busy at all. Posting a fresh
        # dispatch under a live run is a second reviewer on one spec, whoever is running. Fails
        # closed — an unreadable answer counts as in flight, and run_in_flight says so.
        if run_in_flight(key):
            continue
        if DRY:
            log(f"WOULD dispatch claude-spec-reviewer on {key} under {trigger}")
            continue
        # Remembered BEFORE the post, and forever, for the slice loop's reason: a dispatch that is
        # lost costs a stalled card a human can nudge, and one that fires twice costs two reviewers
        # writing findings on one spec. The FAILED line below makes the first one visible.
        if already_retried(fired, remember=True, forever=True):
            continue
        if mc("issue", "comment", "add", key, "--parent", trigger, "--content-stdin",
              stdin=SPEC_FALLBACK_BODY) is None:
            log(f"FAILED  spec-review fallback on {key} — the dispatch comment did not post")
        else:
            log(f"spec-review fallback: {key} — codex-spec-reviewer failed on the usage limit; "
                f"dispatched claude-spec-reviewer under {trigger}")


def list_issues():
    """Every issue on the board, page by page — not just the first one.

    `issue list` answers ONE page: {has_more, issues, limit, offset, total}. Reading only that
    page made every issue past it invisible to every decision this router makes, and silently:
    on 2026-09-14 the board passed 50 issues and AMBR-56 sat in `todo` on page 2, unroutable,
    while the log said nothing worse than "more issues than one page". A note is not a router.
    The CLI's own contract is to advance --offset by the number of issues in the response that
    reported has_more, which is what this does.

    `agent list` and `squad list` return bare arrays; accept that shape rather than assume one.

    A page that fails stops the walk but does not fail the tick: routing the issues already
    read is strictly better than routing none, and the truncation note says the read was short
    so a partial board is never mistaken for the whole one. None is a different answer — page
    one itself was unreadable, which is a broken CLI rather than a short board, and the caller
    gives up on the tick.
    """
    issues, offset = [], 0
    for _ in range(MAX_PAGES):
        out = mc("issue", "list", "--output", "json",
                 "--limit", str(PAGE_SIZE), "--offset", str(offset))
        try:
            parsed = json.loads(out) if out is not None else None
        except json.JSONDecodeError:
            parsed = None
        if parsed is None:
            if not issues:
                return None
            log(f"note: board read truncated — more issues than one page, and the page at "
                f"offset {offset} could not be read; routing the {len(issues)} issues read so far")
            return issues
        if not isinstance(parsed, dict):
            return issues + list(parsed)      # a bare array: no envelope, nothing to page
        got = parsed.get("issues") or []
        issues += got
        # `not got` guards the other direction: a CLI that keeps reporting has_more while
        # answering nothing would otherwise spin here until the page cap.
        if not parsed.get("has_more") or not got:
            return issues
        offset += len(got)
    log(f"note: board read truncated at {MAX_PAGES} pages ({len(issues)} issues) — "
        f"the CLI is still reporting more")
    return issues


def main():
    issues = list_issues()
    if issues is None:
        log("could not read the board"); return 1

    # Outage mode first: it decides where Code goes on this very tick, and whether the model
    # fallback runs at all. Both models are on the exhausted account, so probing Astra every
    # hour would buy nothing; when the outage clears, the next tick's fallback tick sees a
    # long-expired `since` and restores Astra by itself.
    if CODEX_BACK:
        state = read_outage()
        if not os.path.exists(OUTAGE):
            log("--codex-back: no codex outage state file — nothing to clear")
            outage = None
        elif state and not CODEX_FORCE and hand_back_held(issues):
            # Held, not failed: the file stays, this tick keeps routing Code to the stand-in
            # whose run it is, and the next --codex-back — or the next tick once `until` has
            # passed — hands the card back on its own.
            log("--codex-back: holding, the state file stays — re-run it when the run has "
                "finished, or pass --force to clear it anyway")
            outage = state
        else:
            clear_outage("--codex-back --force" if CODEX_FORCE else "--codex-back")
            outage = None
    elif CODEX_OUTAGE_UNTIL is not None:
        outage = open_outage_by_hand(CODEX_OUTAGE_UNTIL)
        if outage is None:
            return 1
    else:
        outage = codex_outage_tick(issues)
    routes = {**ROUTES, **OUTAGE_ROUTES} if outage else ROUTES

    if not DRY and not outage:
        model_fallback_tick(issues)

    # The slice loop rides on the same issue list. It runs ahead of the routing loop and is
    # independent of it: it only ever touches cards whose column and assignee are ALREADY
    # what the routing loop wants, so the two never act on the same card for the same reason.
    # It needs the outage state only to know that a rerun on the Codex account would die.
    slice_tick(issues, outage)

    # The spec-review fallback rides on the same issue list and the same outage state, and for the
    # same reason the slice loop does: the card it acts on already sits in the column and with the
    # agent the routing loop below would choose, so that loop will never see it as work to do.
    spec_review_fallback_tick(issues, outage)

    names = {}
    for kind in ("agent", "squad"):
        listed = mc(kind, "list", "--output", "json")
        if listed:
            rows = json.loads(listed)
            for a in (rows if isinstance(rows, list) else rows.get(kind + "s", [])):
                names[a["id"]] = a["name"]

    for i in issues:
        status = i.get("status")
        if status in NEVER_TOUCH or status not in routes:
            continue
        key = i.get("identifier")
        current = names.get(i.get("assignee_id"), "")
        if i.get("assignee_type") == "member":
            current = "everettyan"          # the only member on this board
        if PARKED_WITH.get(status) == current:
            continue
        # Only the development pipeline is routed by column. An issue handed to some other
        # actor — the research squad, a one-off reviewer, a specialist — was assigned by a
        # human on purpose, and the column says nothing about it. Overriding that is how
        # AMBR-30 (a research question sitting in `todo`) got yanked from the research
        # squad to the planner mid-run, leaving its leader unable to be woken at all.
        # A human assignee is different: an issue parked with Everett and then moved
        # by him into a pipeline column is the normal way a blocked card re-enters
        # the loop, and it must route. Only another *agent or squad* is a deliberate
        # choice the router must not override.
        if current and current not in PIPELINE_ACTORS and current != "everettyan":
            continue
        want = routes[status]
        if current == want:
            # Normally a no-op, and deliberately so: a task that failed on its own terms
            # (an agent out of credits, a refusal) must not be re-triggered in a loop.
            # The exception is an infrastructure cancellation — a daemon restart kills
            # in-flight tasks with "task cancelled by server", which leaves the issue
            # stranded in the right column with the right assignee and nothing running.
            # That one is safe to retry, because nothing about the work was decided.
            if not cancelled_by_server(key) or already_retried(key):
                continue
            log(f"retrying {key} ({status}) — last run was cancelled by the server")
            if DRY:
                log(f"WOULD retry {key} by re-assigning {want}")
                continue
            already_retried(key, remember=True)
            # Re-assigning the same agent is a no-op, so the assignee has to be cleared
            # first for the assignment to register as a change and start a task.
            mc("issue", "assign", key, "--unassign")
        elif outage and status == "code" and current == ROUTES["code"]:
            # Outage mode inherits a card mid-flight: it sits in Code with the Codex
            # implementer's name on it and two runs that died on the usage limit. Hand it
            # across ONCE — its own key in the retry memory, so a failed hand-over is
            # retried next hour but a working one is never re-queued, and so this never
            # spends the card's ordinary retry budget.
            if already_retried(f"{key}:codex-outage"):
                continue
            log(f"codex outage — {key} ({status}) is with {current}, whose account is out of credits")
            if DRY:
                log(f"WOULD re-route {key} {current} -> {want}")
                continue
            already_retried(f"{key}:codex-outage", remember=True)
            mc("issue", "assign", key, "--unassign")
        if DRY:
            log(f"WOULD assign {key} ({status}) {current or '(none)'} -> {want}"); continue
        if mc("issue", "assign", key, "--to", want) is None:
            log(f"FAILED  {key} ({status}) -> {want}")
        else:
            log(f"assigned {key} ({status}) {current or '(none)'} -> {want}")
    return 0


if __name__ == "__main__":
    # One instance at a time. launchd fires every 60 s and a human may run it by hand;
    # two overlapping runs each enqueue a task for the same issue.
    import fcntl
    lock = open(LOCK, "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        print("another router run is in progress; exiting")
        sys.exit(0)
    sys.exit(main())
