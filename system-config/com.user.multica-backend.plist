<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.user.multica-backend</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>-c</string>
    <string>set -a; . "$HOME/agents/multica/.env"; set +a; cd "$HOME/agents/research/multica/src" &amp;&amp; ./server/bin/migrate up &amp;&amp; exec ./server/bin/server</string></array>
  <key>WorkingDirectory</key><string>/Users/orchestrator/agents/research/multica/src</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/orchestrator/agents/multica/logs/backend.log</string>
  <key>StandardErrorPath</key><string>/Users/orchestrator/agents/multica/logs/backend.err</string>
</dict></plist>
