<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>CORS_ALLOWED_ORIGINS</key>
		<string>http://localhost:3000,http://m4-mini.tail5cb205.ts.net,https://m4-mini.tail5cb205.ts.net</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.user.multica-backend</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>-c</string>
		<string>set -a; . "$HOME/agents/multica/.env"; set +a; cd "$HOME/agents/research/multica/src" &amp;&amp; ./server/bin/migrate up &amp;&amp; exec ./server/bin/server</string>
	</array>
	<key>RunAtLoad</key>
