<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.user.multica-router</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>-c</string>
    <string>exec /usr/bin/python3 "$HOME/agents/scripts/multica-router.py"</string></array>
  <key>StartInterval</key><integer>60</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/orchestrator/agents/logs/multica-router.out</string>
  <key>StandardErrorPath</key><string>/Users/orchestrator/agents/logs/multica-router.err</string>
</dict>
</plist>
