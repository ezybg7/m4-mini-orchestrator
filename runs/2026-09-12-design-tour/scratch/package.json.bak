{
  "name": "pantry",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "lint": "expo lint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "posttest": "node scripts/test-timezones.mjs",
    "test:zones": "node scripts/test-timezones.mjs",
    "test:acceptance": "node scripts/run-acceptance.mjs",
    "sync": "bash scripts/sync-main.sh"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~7.11.0",
    "@supabase/postgrest-js": "2.115.0",
    "@tanstack/query-async-storage-persister": "^5.102.8",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-persist-client": "^5.102.8",
    "expo": "~57.0.15",
    "expo-apple-authentication": "~57.0.1",
    "expo-auth-session": "~57.0.8",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.9",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.14",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.2",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-image-manipulator": "~57.0.12",
    "expo-image-picker": "~57.0.12",
    "expo-keep-awake": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.13",
    "expo-router": "~57.0.15",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-purchases": "^10.7.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/js-yaml": "4.0.9",
    "@types/react": "~19.2.2",
    "better-auth": "1.7.2",
    "drizzle-orm": "0.45.2",
    "esbuild": "0.28.1",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.4",
    "js-yaml": "4.3.1",
    "marked": "18.0.12",
    "postgres": "3.4.9",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  }
}
